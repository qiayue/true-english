{
  "name": "true-english",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "用真实推文教中文母语者写英文",
  "scripts": {
    "diff": "tsx src/cli/diff.ts",
    "card": "tsx src/cli/card.ts",
    "score": "tsx src/cli/score.ts",
    "eval": "tsx src/cli/eval.ts",
    "typecheck": "tsc --noEmit",
    "report": "tsx src/cli/report.ts",
    "corpus": "tsx src/cli/corpus.ts",
    "demo": "tsx src/cli/demo.ts",
    "dev": "tsx src/server/index.ts",
    "seed:example": "node scripts/seed-example.mjs",
    "shot": "node scripts/screenshot.mjs",
    "start": "tsx src/server/index.ts",
    "check": "node scripts/check-ui.mjs && tsc --noEmit && npm run test",
    "smoke": "node scripts/smoke.mjs",
    "test": "tsx tests/schedule.ts && tsx tests/paste.ts && tsx tests/llm.ts"
  },
  "dependencies": {
    "tsx": "^4.19.2",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "playwright": "^1.62.1",
    "typescript": "^5.7.2"
  },
  "engines": {
    "node": ">=22.5.0"
  }
}
