# 访问口令。必设 —— 没设的话服务器只绑 127.0.0.1，公网访问不到（这是故意的）。
# 生成：node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
TRUE_ENGLISH_TOKEN=

# 可选。设了就是自动批改，不设就用手工批改模式（页面导出请求 → 贴给 Claude → 贴回 JSON）
ANTHROPIC_API_KEY=

# 可选，默认 data/true-english.db；容器里是 /data/true-english.db
TRUE_ENGLISH_DB=
